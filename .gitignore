# Zavisnosti i build
node_modules/
dist/

# Tajne i podesavanja po masini (primer za server: deploy/env.production.example)
.env
.env.*

# Podaci koji nastaju u radu: baza, logovi, izvestaji, backup-i i snimci
data/
*.log

