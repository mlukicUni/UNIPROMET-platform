# UNIPROMET Admin - systemd servis za Linux server (192.168.121.26)
#
# Instalacija: sudo bash deploy/install-services.sh (zajedno sa tajmerima za azuriranje i backup),
# a pri prelasku na produkciju: sudo systemctl enable --now unipromet-admin
#
# TZ važi samo za aplikaciju (scheduler radi po lokalnom vremenu), sistemsko vreme servera ostaje UTC.
# KillMode=control-group gasi i go2rtc koji aplikacija pokreće kao podproces.

[Unit]
Description=UNIPROMET Admin (Node.js)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=uniadmin
Group=uniadmin
WorkingDirectory=/opt/unipromet-admin
Environment=TZ=Europe/Belgrade
ExecStart=/usr/bin/node dist/server.js
Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=15
StandardOutput=append:/opt/unipromet-admin/data/logs/server.out.log
StandardError=append:/opt/unipromet-admin/data/logs/server.err.log

[Install]
WantedBy=multi-user.target
