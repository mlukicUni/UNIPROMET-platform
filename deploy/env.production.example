# .env za Linux produkciju (192.168.121.26) - primer BEZ tajnih vrednosti.
# Na serveru: kopirati u /opt/unipromet-admin/.env, popuniti vrednosti, pa chmod 600 .env
# Ne kopirati SERVER_SSH_* ni LDAP_* (vise se ne koriste na serveru).

PORT=3000

# Microsoft Entra ID (SSO + Graph)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_CLIENT_SECRET_EXPIRES=YYYY-MM-DD
SESSION_SECRET=
SUPER_ADMIN_EMAILS=

# 192.168.121.20 (legacy baza) i Navision
DB_121_20_USER=
DB_121_20_PASS=

# Kamere i Aruba
CAMERA_USER=
CAMERA_PASS_1=
CAMERA_PASS_2=
CAMERA_PASS=
ARUBA_PASS=

# Podesavanja po masini - produkcija
PUBLIC_URL=https://192.168.121.26:3000
SCHEDULER_ENABLED=true
LEGACY_SYNC_ENABLED=true
# MAIL_REDIRECT_TO ostaje prazan na produkciji
ENABLE_DEV_LOGIN=false

# Mejl o automatskom azuriranju sa GitHub-a i o neuspelom backup-u (prazno = bez mejla)
DEPLOY_NOTIFY_TO=
# Koliko dana se cuvaju dnevne kopije baze u data/backups/daily
BACKUP_KEEP_DAYS=14

# Za probni rad sa kopijom baze (pre prelaska) privremeno:
#SCHEDULER_ENABLED=false
#LEGACY_SYNC_ENABLED=false
#MAIL_REDIRECT_TO=<tvoj mejl>
